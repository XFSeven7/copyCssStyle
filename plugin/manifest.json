{
  "manifest_version": 3,
  "name": "copyCssStyle",
  "version": "1.2",
  "description": "一键复制css样式",
  "permissions": [
    "contextMenus",
    "activeTab",
    "storage"
  ],
  "homepage_url": "https://github.com/XFSeven7/copyCssStyle",
  "action": {
    "default_icon": {
      "16": "src/assets/icons/logo-gray-16.png",
      "32": "src/assets/icons/logo-gray-32.png",
      "48": "src/assets/icons/logo-gray-48.png"
    }
  },
  "icons": {
    "16": "src/assets/icons/logo-16.png",
    "32": "src/assets/icons/logo-32.png",
    "48": "src/assets/icons/logo-48.png"
  },

  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "src/cssDiff.js",
        "src/content.js"
      ]
    }
  ]
}
